# ============================================================
# Dhruba Power Platform — Production Environment Configuration
# ============================================================

# PORT: The port the HTTP server listens on (Cloud Run / Docker sets this automatically)
PORT=3000

# NODE_ENV: Node execution environment ('production' or 'development')
NODE_ENV=production

# APP_URL: The public canonical URL of the application
APP_URL="https://dhrubapower.com"

# DATABASE_PATH: Absolute or relative path to SQLite database file
DATABASE_PATH="./data/dhruba_power.db"

# JWT_SECRET: Cryptographic secret used for signing customer and staff session tokens
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-secure-random-secret-key-for-jwt-signing"

# ADMIN_DEFAULT_PASSWORD: Initial password for admin@dhrubapower.com during first boot database initialization
ADMIN_DEFAULT_PASSWORD="replace-with-strong-admin-password"

# STORAGE_PATH: Persistent uploads directory for product images, CAD files, and customer BOQ uploads
STORAGE_PATH="./uploads"

# GEMINI_API_KEY: Optional Google Gemini API key for automated product categorization
GEMINI_API_KEY=""
